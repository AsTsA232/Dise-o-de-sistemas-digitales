`timescale 1ns / 1ps

module mqef
#(parameter N=15)
(
    input  logic clk,
    input  logic reset,
    input  logic go,
    input  logic [3:0] n,
    output logic [3:0] out,
    output logic stop 
);

//contador señales
logic [3:0] out_reg, out_next;

//maquina de estados
typedef enum logic [2:0] {s0, s1, s2, s3} state_type;
state_type state_reg, state_next;  
    
    always_ff @(posedge clk, posedge reset) begin
        if (reset) begin
            state_reg <= s0;
            out_reg   <= 0;
        end else begin
            state_reg <= state_next;
            out_reg   <= out_next;
        end
    end


    always_comb begin
        state_next <= state_reg; 
        out_next  <= out_reg;   

        case (state_reg)
            s0: begin
                out_next <= 0;  
                stop<=1'b0;     
                if (go)             
                    state_next <= s1;
                else
                    state_next <= s0;
            end

            s1: state_next <= s2;

            s2: begin
                out_next <= out_reg + 1;
                if (out_reg + 1 == n) 
                    state_next <= s3;
                else
                    state_next <= s2;
            end

            s3: begin
                state_next <= s0; 
                stop<=1'b1;
            end

            default: begin
                state_next <= s0;
                out_next <= 0;
            end
        endcase
    end

    assign out = out_reg;

endmodule
